package Binary32
import NoWurst

/**
 * Rounds to the nearest IEEE 754 binary32 numerical value, with ties to even.
 * The result remains a real; call after each operation that requires rounding.
 *
 * On a binary64 real runtime (Lua), this includes binary32
 * subnormals, signed underflow to zero, and overflow to signed infinity.
 * NaN and infinity pass through. NaN payloads are not part of this contract.
 * On a binary32 real runtime (Jass and the compiletime interpreter), inputs
 * have already been rounded; this cannot recover precision lost before the
 * call. A runtime that flushes subnormals
 * to zero cannot preserve values below 2^-126 through this function.
 *
 * Uses at most 127 power-of-two scaling steps, independent of input magnitude.
 */
public function real.roundToFloat32() returns real
	if this == 0. or this != this
		return this
	let negative = this < 0.
	var significand = negative ? -this : this
	var scale = 1.
	var exponent = 0
	while significand >= 2. and exponent < 127
		significand *= 0.5
		scale *= 2.
		exponent += 1
	if significand >= 2.
		return negative ? -binary32Infinity() : binary32Infinity()
	while significand < 1. and exponent > -126
		significand *= 2.
		scale *= 0.5
		exponent -= 1
	let units = significand * 8388608.
	var rounded = R2I(units)
	let remainder = units - rounded
	if remainder > 0.5 or (remainder == 0.5 and rounded mod 2 != 0)
		rounded += 1
	if exponent == 127 and rounded == 16777216
		return negative ? -binary32Infinity() : binary32Infinity()
	let result = (rounded / 8388608.) * scale
	return negative ? -result : result

/**
 * Adds two finite binary32 operands and rounds the exact sum once to nearest,
 * ties to even. Pass operands separately so a binary32 runtime cannot discard
 * low bits while evaluating the addition before this function is called.
 * Subnormal inputs and outputs follow the runtime's flush-to-zero behavior.
 */
public function addFloat32(real a, real b) returns real
	return fusedMultiplyAddFloat32(1., a, b)

/**
 * Subtracts two finite binary32 operands and rounds the exact difference once
 * to nearest, ties to even. Pass operands separately to retain their input
 * bits on runtimes whose ordinary subtraction already rounds to binary32.
 * Subnormal inputs and outputs follow the runtime's flush-to-zero behavior.
 */
public function subtractFloat32(real a, real b) returns real
	return fusedMultiplyAddFloat32(-1., b, a)

/**
 * Multiplies two finite binary32 operands and rounds the exact product once
 * to nearest, ties to even. Preserving subnormals requires a runtime that does
 * not flush them to zero. Subnormal inputs follow the same runtime behavior.
 */
public function multiplyFloat32(real a, real b) returns real
	return fusedMultiplyAddFloat32(a, b, 0.)

/**
 * Divides finite binary32 operands and rounds the exact quotient to nearest,
 * ties to even. Integer long division retains the quotient and sticky remainder
 * without a rounded real division. Zero numerator is supported; a zero divisor
 * returns NaN. Preserving subnormal outputs requires a runtime that does not
 * flush them to zero; subnormal inputs follow the same runtime behavior.
 */
public function divideFloat32(real numerator, real denominator) returns real
	if denominator == 0.
		let infinity = binary32Infinity()
		return infinity - infinity
	if numerator == 0.
		return numerator
	let left = decomposeBinary32(numerator)
	let right = decomposeBinary32(denominator)
	var remainder = left.significand
	var exponent = left.exponent - right.exponent
	if remainder < right.significand
		remainder *= 2
		exponent -= 1
	remainder -= right.significand
	var quotient = 1
	for i = 1 to 26
		remainder *= 2
		quotient *= 2
		if remainder >= right.significand
			remainder -= right.significand
			quotient += 1
	var rounded = quotient div 8
	let roundingBits = quotient mod 8
	if roundingBits > 4 or (roundingBits == 4 and (remainder != 0 or rounded mod 2 != 0))
		rounded += 1
	var scale = exponent - 23
	if exponent < -126
		let subnormalShift = exponent + 149
		if subnormalShift < -1
			return 0.
		if subnormalShift == -1
			rounded = (quotient != 67108864 or remainder != 0) ? 1 : 0
		else
			var divisor = 1
			for i = 1 to 26 - subnormalShift
				divisor *= 2
			rounded = quotient div divisor
			let roundingRemainder = quotient mod divisor
			if roundingRemainder * 2 > divisor or
				(roundingRemainder * 2 == divisor and (remainder != 0 or rounded mod 2 != 0))
				rounded += 1
		scale = -149
	else if rounded == 16777216
		rounded = 8388608
		exponent += 1
		scale = exponent - 23
	if exponent > 127 or (exponent == 127 and rounded == 16777216)
		return ((numerator < 0.) != (denominator < 0.)) ? -binary32Infinity() : binary32Infinity()
	var result = rounded * 1.
	if scale < 0
		for i = 1 to -scale
			result *= 0.5
	else
		for i = 1 to scale
			result *= 2.
	return ((numerator < 0.) != (denominator < 0.)) ? -result : result

function binary32Infinity() returns real
	// 2^(24 * 64) overflows both binary32 and binary64, without division by zero.
	var result = 16777216.
	for i = 1 to 6
		result *= result
	return result

/**
 * Computes a * b + c with one binary32 rounding, nearest with ties to even.
 * All three inputs must be finite, already-representable binary32 values.
 * The exact product may overflow or underflow binary32 before cancellation.
 * NaN and infinity inputs are outside this function's contract.
 *
 * Integer limbs retain the product and cancellation bits on both binary32
 * and binary64 real runtimes. No intermediate real multiplication is rounded.
 * Preserving subnormals requires a runtime that does not flush them to zero.
 */
public function fusedMultiplyAddFloat32(real a, real b, real c) returns real
	if a == 0. or b == 0.
		return a * b + c
	let left = decomposeBinary32(a)
	let right = decomposeBinary32(b)
	let product = multiplyBinary32Significands(left.significand, right.significand)
	// Leave one carry bit above the product and 23 exact zero bits below it.
	var magnitude = binary32Limbs(product.high div 2,
		(product.high mod 2) * 8388608 + product.low div 2,
		(product.low mod 2) * 8388608)
	var scale = left.exponent + right.exponent - 23
	var negative = (a < 0.) != (b < 0.)
	if c != 0.
		let addend = decomposeBinary32(c)
		var other = binary32Limbs(addend.significand div 2,
			(addend.significand mod 2) * 8388608, 0)
		let otherScale = addend.exponent - 47
		if scale < otherScale
			magnitude = magnitude.shiftRightJam(otherScale - scale)
			scale = otherScale
		else
			other = other.shiftRightJam(scale - otherScale)
		if negative == (c < 0.)
			magnitude = magnitude.add(other)
		else if magnitude.lessThan(other)
			magnitude = other.subtract(magnitude)
			negative = c < 0.
		else
			magnitude = magnitude.subtract(other)
	return magnitude.roundBinary32(scale, negative)

// Three base-2^24 limbs. Arithmetic on each limb stays within signed int range.
tuple binary32Limbs(int high, int middle, int low)
tuple binary32Parts(int significand, int exponent)
tuple binary32Product(int high, int low)

function decomposeBinary32(real value) returns binary32Parts
	var normalized = value < 0. ? -value : value
	var exponent = -23
	while normalized >= 2.
		normalized *= 0.5
		exponent += 1
	while normalized < 1.
		normalized *= 2.
		exponent -= 1
	return binary32Parts(R2I(normalized * 8388608.), exponent)

function multiplyBinary32Significands(int a, int b) returns binary32Product
	// Twelve-bit factors keep every partial product within signed int range.
	let aLow = a mod 4096
	let bLow = b mod 4096
	let aHigh = a div 4096
	let bHigh = b div 4096
	let first = aLow * bLow
	let second = first div 4096 + aHigh * bLow + aLow * bHigh
	return binary32Product(aHigh * bHigh + second div 4096,
		first mod 4096 + (second mod 4096) * 4096)

function binary32Limbs.shiftRightJam(int count) returns binary32Limbs
	var result = this
	if count >= 72
		return binary32Limbs(0, 0, (this.high != 0 or this.middle != 0 or this.low != 0) ? 1 : 0)
	var remaining = count
	while remaining >= 24
		let lost = result.low != 0
		result = binary32Limbs(0, result.high, result.middle)
		if lost and result.low mod 2 == 0
			result.low += 1
		remaining -= 24
	for i = 1 to remaining
		let lost = result.low mod 2 != 0
		result = binary32Limbs(result.high div 2,
			result.middle div 2 + (result.high mod 2) * 8388608,
			result.low div 2 + (result.middle mod 2) * 8388608)
		if lost and result.low mod 2 == 0
			result.low += 1
	return result

function binary32Limbs.add(binary32Limbs other) returns binary32Limbs
	let lowSum = this.low + other.low
	let middleSum = this.middle + other.middle + lowSum div 16777216
	return binary32Limbs(this.high + other.high + middleSum div 16777216,
		middleSum mod 16777216, lowSum mod 16777216)

function binary32Limbs.lessThan(binary32Limbs other) returns boolean
	return this.high < other.high or (this.high == other.high and
		(this.middle < other.middle or (this.middle == other.middle and this.low < other.low)))

// The receiver must be at least as large as other.
function binary32Limbs.subtract(binary32Limbs other) returns binary32Limbs
	var lowDifference = this.low - other.low
	var middleDifference = this.middle - other.middle
	var highDifference = this.high - other.high
	if lowDifference < 0
		lowDifference += 16777216
		middleDifference -= 1
	if middleDifference < 0
		middleDifference += 16777216
		highDifference -= 1
	return binary32Limbs(highDifference, middleDifference, lowDifference)

function binary32BitLength(int value) returns int
	var remaining = value
	var result = 0
	while remaining != 0
		remaining = remaining div 2
		result += 1
	return result

function binary32Limbs.roundBinary32(int scale, boolean negative) returns real
	let bits = this.high != 0 ? 48 + binary32BitLength(this.high) :
		(this.middle != 0 ? 24 + binary32BitLength(this.middle) : binary32BitLength(this.low))
	if bits == 0
		return 0.
	var shift = bits - 24
	if scale + shift < -149
		shift = -149 - scale
	var rounded = this.low
	var resultScale = scale
	if shift >= 2
		let truncated = this.shiftRightJam(shift - 2)
		rounded = truncated.middle * 4194304 + truncated.low div 4
		let remainder = truncated.low mod 4
		if remainder > 2 or (remainder == 2 and rounded mod 2 != 0)
			rounded += 1
		resultScale += shift
	else if shift == 1
		rounded = this.middle * 8388608 + this.low div 2
		if this.low mod 2 != 0 and rounded mod 2 != 0
			rounded += 1
		resultScale += 1
	if resultScale + binary32BitLength(rounded) > 128
		return negative ? -binary32Infinity() : binary32Infinity()
	var result = rounded * 1.
	if resultScale < 0
		for i = 1 to -resultScale
			result *= 0.5
	else
		for i = 1 to resultScale
			result *= 2.
	return negative ? -result : result
