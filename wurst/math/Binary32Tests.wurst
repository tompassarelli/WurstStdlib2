package Binary32Tests
import NoWurst
import Binary32
import Wurstunit

// Execute these functions in emitted Lua too: the compiletime interpreter's
// binary32 arithmetic rounds inputs before roundToFloat32 can examine them.
@Test public function subtractionRoundsExactly()
	let difference = 0.7562744617462158 - 0.07999999821186066
	(difference.roundToFloat32() == 0.6762744784355164).assertTrue()
	((-difference).roundToFloat32() == -0.6762744784355164).assertTrue()

@Test public function halfwayUsesEvenSignificand()
	let halfUlp = powerOfTwo(-24)
	((1. + halfUlp).roundToFloat32() == 1.).assertTrue()
	((1. + 3. * halfUlp).roundToFloat32() == 1. + 4. * halfUlp).assertTrue()
	((-1. - halfUlp).roundToFloat32() == -1.).assertTrue()
	((-1. - 3. * halfUlp).roundToFloat32() == -1. - 4. * halfUlp).assertTrue()

@Test public function roundingCarriesIntoNextExponent()
	((2. - powerOfTwo(-24)).roundToFloat32() == 2.).assertTrue()
	((16777216. + 1.).roundToFloat32() == 16777216.).assertTrue()
	((16777216. + 3.).roundToFloat32() == 16777220.).assertTrue()

@Test public function tinyAndSubnormalValues()
	(0.00000001.roundToFloat32() == 0.00000000999999993922529029077850282192230224609375).assertTrue()
	let quantum = powerOfTwo(-149)
	(quantum.roundToFloat32() == quantum).assertTrue()
	((quantum * 0.5).roundToFloat32() == 0.).assertTrue()
	((quantum * 1.5).roundToFloat32() == quantum * 2.).assertTrue()
	((quantum * 2.5).roundToFloat32() == quantum * 2.).assertTrue()
	((-quantum * 1.5).roundToFloat32() == -quantum * 2.).assertTrue()
	let minimumNormal = powerOfTwo(-126)
	((minimumNormal - quantum * 0.5).roundToFloat32() == minimumNormal).assertTrue()
	(powerOfTwo(-200).roundToFloat32() == 0.).assertTrue()

@Test public function rangeAndNonfiniteValues()
	let lastSpacing = powerOfTwo(104)
	let maximum = 16777215. * lastSpacing
	(maximum.roundToFloat32() == maximum).assertTrue()
	let infinity = powerOfTwo(1023) * 2.
	((16777215.5 * lastSpacing).roundToFloat32() == infinity).assertTrue()
	((-16777215.5 * lastSpacing).roundToFloat32() == -infinity).assertTrue()
	(infinity.roundToFloat32() == infinity).assertTrue()
	((-infinity).roundToFloat32() == -infinity).assertTrue()
	let nan = infinity - infinity
	(nan.roundToFloat32() != nan.roundToFloat32()).assertTrue()
	(0.0.roundToFloat32() == 0.).assertTrue()

function powerOfTwo(int exponent) returns real
	var result = 1.
	if exponent < 0
		for i = 1 to -exponent
			result *= 0.5
	else
		for i = 1 to exponent
			result *= 2.
	return result

@Test public function fusedProductRetainsCancellationBits()
	let next = 1. + powerOfTwo(-23)
	let previous = 1. - powerOfTwo(-23)
	(fusedMultiplyAddFloat32(next, previous, -1.) == -powerOfTwo(-46)).assertTrue()
	((next * previous).roundToFloat32() - 1. == 0.).assertTrue()
	(fusedMultiplyAddFloat32(next, next, -(1. + powerOfTwo(-22))) == powerOfTwo(-46)).assertTrue()
	(fusedMultiplyAddFloat32(-next, previous, 1.) == powerOfTwo(-46)).assertTrue()
	(fusedMultiplyAddFloat32(2., 3., -6.) == 0.).assertTrue()

@Test public function fusedRoundingUsesExactProduct()
	let next = 1. + powerOfTwo(-23)
	let halfUlp = powerOfTwo(-24)
	(fusedMultiplyAddFloat32(next, next, halfUlp) == 1. + 3. * powerOfTwo(-23)).assertTrue()
	(((next * next).roundToFloat32() + halfUlp).roundToFloat32() == 1. + powerOfTwo(-22)).assertTrue()
	(fusedMultiplyAddFloat32(1., halfUlp, 1.) == 1.).assertTrue()
	(fusedMultiplyAddFloat32(1., halfUlp, next) == 1. + powerOfTwo(-22)).assertTrue()
	(fusedMultiplyAddFloat32(-1., powerOfTwo(-100), 1.) == 1.).assertTrue()

@Test public function fusedRangeBeforeFinalRounding()
	let maximum = 16777215. * powerOfTwo(104)
	(fusedMultiplyAddFloat32(maximum, 2., -maximum) == maximum).assertTrue()
	let quantum = powerOfTwo(-149)
	(fusedMultiplyAddFloat32(quantum, 0.5, quantum) == quantum * 2.).assertTrue()
	(fusedMultiplyAddFloat32(-quantum, 0.5, -quantum) == -quantum * 2.).assertTrue()
	(fusedMultiplyAddFloat32(quantum, quantum, 0.) == 0.).assertTrue()
	(fusedMultiplyAddFloat32(0., maximum, 3.) == 3.).assertTrue()
	(fusedMultiplyAddFloat32(maximum, 2., maximum) == powerOfTwo(1023) * 2.).assertTrue()

@Test public function separateOperandAdditionMatchesNearestBinary32()
	(addFloat32(0.7, 0.1) == 0.800000011920928955078125).assertTrue()
	(addFloat32(1., powerOfTwo(-24)) == 1.).assertTrue()
	(addFloat32(1., 3. * powerOfTwo(-24)) == 1. + powerOfTwo(-22)).assertTrue()
	(addFloat32(0.7, 0.1) == addFloat32(0.1, 0.7)).assertTrue()
	(addFloat32(0.7, -0.7) == 0.).assertTrue()
	(addFloat32(-0.7, -0.1) == -0.800000011920928955078125).assertTrue()

@Test public function separateOperandSubtractionRetainsCancellation()
	(subtractFloat32(1.00000011920928955078125, 1.) == powerOfTwo(-23)).assertTrue()
	(subtractFloat32(0.7, 0.1) == 0.599999964237213134765625).assertTrue()
	(subtractFloat32(-0.7, 0.1) == -0.800000011920928955078125).assertTrue()

@Test public function separateOperandMultiplicationRoundsNearest()
	(multiplyFloat32(1.5, 1. + powerOfTwo(-23)) == 1.5 + 2. * powerOfTwo(-23)).assertTrue()
	(multiplyFloat32(1.5, 1. + powerOfTwo(-23)) == multiplyFloat32(1. + powerOfTwo(-23), 1.5)).assertTrue()
	(multiplyFloat32(0.7, -0.1) == -0.070000000298023223876953125).assertTrue()
	(multiplyFloat32(powerOfTwo(-149), 0.5) == 0.).assertTrue()

@Test public function separateOperandDivisionRoundsQuotients()
	(divideFloat32(1., 3.) == 0.3333333432674407958984375).assertTrue()
	(divideFloat32(1., 2.) == 0.5).assertTrue()
	(divideFloat32(3., 2.) == 1.5).assertTrue()
	(divideFloat32(-1., 3.) == -0.3333333432674407958984375).assertTrue()
	(divideFloat32(powerOfTwo(-149), 1.) == powerOfTwo(-149)).assertTrue()
	(divideFloat32(powerOfTwo(-149), 2.) == 0.).assertTrue()
	(divideFloat32(3. * powerOfTwo(-149), 2.) == 2. * powerOfTwo(-149)).assertTrue()
	(divideFloat32(powerOfTwo(-126), 2.) == powerOfTwo(-127)).assertTrue()
	(divideFloat32(0., 3.) == 0.).assertTrue()

@Test public function zeroDivisorReturnsNaN()
	let invalid = divideFloat32(1., 0.)
	(invalid != invalid).assertTrue()

@Test public function divisionOverflowReturnsInfinity()
	let maximum = 16777215. * powerOfTwo(104)
	let result = divideFloat32(maximum, 0.5)
	(result == result).assertTrue()
	result.assertGreaterThan(maximum)

@Test public function nearestBinary32OperationChainFixesRuntimeSentinel()
	let afterTwo = addFloat32(addFloat32(0.7, 0.1), 0.1)
	(addFloat32(afterTwo, 0.1) == 1.).assertTrue()
